# Copy to knowledge_base/.env. Process environment takes precedence.
# Full OpenAI-compatible chat completions URL of the EXISTING Dedicated Endpoint.
KB_ENDPOINT_URL=
KB_READER_MODEL=
# Optional; defaults to KB_READER_MODEL.
KB_REPAIR_MODEL=
# Historical V1-V5 only; Pilot V6 does not call a verifier.
KB_VERIFIER_MODEL=
# Optional Bearer authentication:
KB_API_KEY=
# Optional extra headers, JSON object; e.g. provider-specific authentication.
KB_EXTRA_HEADERS_JSON={}
# USD upper estimate for ONE request, including its full timeout.
# REQUIRED before calling API. Obtain from your endpoint billing configuration.
KB_REQUEST_RESERVE_USD=
KB_BUDGET_USD=unlimited
KB_TIMEOUT_SECONDS=120
KB_STARTUP_WAIT_SECONDS=900
KB_MAX_OUTPUT_TOKENS=4096
KB_TEMPERATURE=0
KB_TOP_P=0.9
KB_REASONING_EFFORT=none
KB_MAX_READ_STEPS=6
# V12 safety limit on additional candidate-batch requests per case.
# Hitting it leaves the case incomplete; it never silently truncates source refs.
KB_MAX_SOURCE_SCAN_REQUESTS=24
KB_WINDOW_CHARS=10000
# Paths are relative to the repository root. KOS is optional for the portable K0 snapshot.
KB_KOS_DIR=data/kos_sample
KB_SOURCE_DIR=data/task1_train_files_2026/cases

# Shared AU runtime for pipeline_v1.au_only and pipeline_v1.au_compact.
# Copy real credentials only to knowledge_base/.env (ignored by git). New
# configuration must use these canonical AU_* names. The legacy AU_ONLY_* and
# AU_COMPACT_* names are compatibility fallbacks and are deprecated.
AU_URL=
AU_TOKEN=
AU_MODEL=
# Set true only if the selected model/endpoint supports its thinking mode.
AU_ENABLE_THINKING=false
AU_TRANSPORT=direct
AU_STRING_DECODER=bounded
# jobs requires the updated private gateway deployment; blank derives from AU_URL.
AU_JOBS_URL=
AU_JOB_WAIT_SECONDS=1800
AU_JOB_POLL_SECONDS=2
AU_TIMEOUT=60
# Independent runner safety caps; configure them before remote execution.
AU_MAX_REQUESTS=20
AU_MAX_PROVIDER_ATTEMPTS=20
AU_MAX_TOTAL_INPUT_TOKENS=120000
AU_MAX_TOTAL_OUTPUT_TOKENS=32000
# Bounded source-free endpoint warmup, separate from source-request caps.
AU_WARMUP_MAX_ATTEMPTS=10
AU_WARMUP_MAX_WAIT_SECONDS=600
AU_WARMUP_INITIAL_BACKOFF_SECONDS=1
AU_WARMUP_MAX_BACKOFF_SECONDS=30

# Pilot Lynx / Plan 10 Modal Dedicated Endpoint.
# Keep real endpoint and credentials only in knowledge_base/.env (ignored by git).
PLX_ENDPOINT_URL=
PLX_MODEL=Qwen/Qwen3.5-9B
# Qwen thinking changes response shape; Plan 10 baseline keeps it disabled.
PLX_ENABLE_THINKING=false
# Either use a combined wk-....ws-... bearer token:
PLX_PROXY_TOKEN=
# Or provide the two Modal proxy-token parts instead:
PLX_MODAL_KEY=
PLX_MODAL_SECRET=
PLX_COLD_START_WAIT_SECONDS=600
# Dedicated Plan 10 remote safety budget. These do not reuse KB_* values.
# Set the price values from the actual Dedicated Endpoint before a paid run.
PLX_MAX_REQUESTS=1
PLX_MAX_INPUT_TOKENS=12000
# Hard endpoint ceiling; baseline and structural retry caps must not exceed it.
PLX_MAX_OUTPUT_TOKENS=2400
PLX_BASELINE_OUTPUT_TOKENS=1200
PLX_STRUCTURAL_REPAIR_OUTPUT_TOKENS=2400
# Required before paired-run. These are aggregate P2a+P2b reservations, not
# per-request caps; blank values make preflight fail before any remote write/call.
PLX_MAX_TOTAL_INPUT_TOKENS=
PLX_MAX_TOTAL_OUTPUT_TOKENS=
# Optional hard cost ceiling in USD micros (1 USD = 1000000); use none only
# when endpoint token pricing is unavailable and record that limitation.
PLX_MAX_USD_MICROS=none
# Leave at 0 only when endpoint token prices are not known; then USD cannot be
# reserved or reported as an actual cost.
PLX_INPUT_USD_MICROS_PER_1K=0
PLX_OUTPUT_USD_MICROS_PER_1K=0
# Bounded source-free cold-start warmup; separate from AU/P2 ledgers.
PLX_WARMUP_MAX_ATTEMPTS=10
PLX_WARMUP_MAX_SECONDS=600
PLX_WARMUP_INITIAL_BACKOFF_SECONDS=5
PLX_WARMUP_MAX_BACKOFF_SECONDS=60
# Integrated warmup-probe: total locked P2a source attempts, distinct from warmup calls.
PLX_WARM_PROBE_MAX_PROBE_ATTEMPTS=2
