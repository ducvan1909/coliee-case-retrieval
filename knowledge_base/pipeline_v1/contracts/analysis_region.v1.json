{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisWorkloadMap v1",
  "type": "object", "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "case_id", "source_hash", "scheduler_version", "policy_sha256", "cache_key", "dependencies", "block_roles", "targets", "slices", "batches", "regions", "hint_dispositions"],
  "properties": {
    "artifact_type": {"const": "AnalysisWorkloadMap"}, "schema_version": {"const": "analysis-workload-map-v1"}, "case_id": {"$ref": "#/$defs/case"}, "source_hash": {"$ref": "#/$defs/hash"}, "scheduler_version": {"type": "string"}, "policy_sha256": {"$ref": "#/$defs/hash"}, "cache_key": {"$ref": "#/$defs/hash"}, "dependencies": {"$ref": "#/$defs/deps"},
    "block_roles": {"type": "array", "items": {"$ref": "#/$defs/role"}}, "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}}, "slices": {"type": "array", "items": {"$ref": "#/$defs/slice"}}, "batches": {"type": "array", "items": {"$ref": "#/$defs/batch"}}, "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}}, "hint_dispositions": {"type": "array", "items": {"$ref": "#/$defs/hintDisposition"}}
  },
  "$defs": {
    "case": {"type": "string", "pattern": "^[0-9]{6}$"}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "id": {"type": "string", "pattern": "^[a-z]+-[0-9a-f]{24}$"},
    "span": {"type": "object", "additionalProperties": false, "required": ["case_id", "source_hash", "start_char", "end_char"], "properties": {"case_id": {"$ref": "#/$defs/case"}, "source_hash": {"$ref": "#/$defs/hash"}, "start_char": {"type": "integer", "minimum": 0}, "end_char": {"type": "integer", "minimum": 0}}},
    "deps": {"type": "object", "additionalProperties": false, "required": ["sourceblock_cache_key", "sentence_atom_cache_key", "sidecar_cache_key", "context_hint_cache_key", "analysis_region_policy_sha256"], "properties": {"sourceblock_cache_key": {"$ref": "#/$defs/hash"}, "sentence_atom_cache_key": {"$ref": "#/$defs/hash"}, "sidecar_cache_key": {"$ref": "#/$defs/hash"}, "context_hint_cache_key": {"$ref": "#/$defs/hash"}, "analysis_region_policy_sha256": {"$ref": "#/$defs/hash"}}},
    "role": {"type": "object", "additionalProperties": false, "required": ["block_id", "block_type", "span", "content_span", "eligible", "role", "reason"], "properties": {"block_id": {"type": "string"}, "block_type": {"type": "string"}, "span": {"$ref": "#/$defs/span"}, "content_span": {"$ref": "#/$defs/span"}, "eligible": {"type": "boolean"}, "role": {"type": "string"}, "reason": {"type": "string"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["record_type", "target_id", "parent_block_id", "block_order", "content_span", "mode", "slice_ids", "policy_version"], "properties": {"record_type": {"const": "AnalysisTarget"}, "target_id": {"$ref": "#/$defs/id"}, "parent_block_id": {"type": "string"}, "block_order": {"type": "integer", "minimum": 0}, "content_span": {"$ref": "#/$defs/span"}, "mode": {"enum": ["block", "sliced"]}, "slice_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "policy_version": {"type": "string"}}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["record_type", "slice_id", "parent_block_id", "slice_order", "span", "atom_ids", "policy_version", "oversized_atom", "stop_reasons", "target_id"], "properties": {"record_type": {"const": "AnalysisTargetSlice"}, "slice_id": {"$ref": "#/$defs/id"}, "parent_block_id": {"type": "string"}, "slice_order": {"type": "integer", "minimum": 0}, "span": {"$ref": "#/$defs/span"}, "atom_ids": {"type": "array", "items": {"type": "string"}}, "policy_version": {"type": "string"}, "oversized_atom": {"type": "boolean"}, "stop_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "target_id": {"$ref": "#/$defs/id"}}},
    "work": {"type": "object", "additionalProperties": false, "required": ["work_item_id", "target_id", "parent_block_id", "slice_id", "span", "block_order", "stop_reasons"], "properties": {"work_item_id": {"$ref": "#/$defs/id"}, "target_id": {"$ref": "#/$defs/id"}, "parent_block_id": {"type": "string"}, "slice_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}, "span": {"$ref": "#/$defs/span"}, "block_order": {"type": "integer", "minimum": 0}, "stop_reasons": {"type": "array", "items": {"type": "string"}}}},
    "batch": {"type": "object", "additionalProperties": false, "required": ["record_type", "batch_id", "case_id", "source_hash", "ordinal", "work_items", "target_chars", "stop_reasons"], "properties": {"record_type": {"const": "AnalysisBatch"}, "batch_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/case"}, "source_hash": {"$ref": "#/$defs/hash"}, "ordinal": {"type": "integer", "minimum": 0}, "work_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/work"}}, "target_chars": {"type": "integer", "minimum": 0}, "stop_reasons": {"type": "array", "items": {"type": "string"}}}},
    "context": {"type": "object", "additionalProperties": false, "required": ["span", "block_ids", "reasons", "source_hint_ids", "source_relation_ids", "source_statuses", "priority"], "properties": {"span": {"$ref": "#/$defs/span"}, "block_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "source_hint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "source_relation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "source_statuses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "priority": {"type": "integer", "minimum": 0}}},
    "render": {"type": "object", "additionalProperties": false, "required": ["render_key", "role", "span", "ref_ids", "reasons"], "properties": {"render_key": {"type": "string"}, "role": {"enum": ["target", "context"]}, "span": {"$ref": "#/$defs/span"}, "ref_ids": {"type": "array", "items": {"type": "string"}}, "reasons": {"type": "array", "items": {"type": "string"}}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["unique_source_chars", "proposed_source_chars", "repeated_source_chars", "rendered_chars", "overlap_ratio", "estimated_input_tokens"], "properties": {"unique_source_chars": {"type": "integer", "minimum": 0}, "proposed_source_chars": {"type": "integer", "minimum": 0}, "repeated_source_chars": {"type": "integer", "minimum": 0}, "rendered_chars": {"type": "integer", "minimum": 0}, "overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "estimated_input_tokens": {"type": "integer", "minimum": 0}}},
    "event": {"type": "object", "additionalProperties": false, "required": ["candidate_key", "action", "reason", "source_hint_ids"], "properties": {"candidate_key": {"type": "string"}, "action": {"enum": ["kept", "dropped"]}, "reason": {"type": "string"}, "source_hint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "hintDisposition": {"type": "object", "additionalProperties": false, "required": ["hint_id", "target_block_id", "hint_status", "target_eligibility", "disposition"], "properties": {"hint_id": {"type": "string", "pattern": "^ch-[0-9a-f]{24}$"}, "target_block_id": {"type": "string"}, "hint_status": {"enum": ["candidate", "accepted_by_contract", "unresolved"]}, "target_eligibility": {"enum": ["eligible_primary_target", "target_ineligible_structural_only"]}, "disposition": {"enum": ["included_new_span", "included_provenance_only_already_baseline_context", "related_is_primary", "target_ineligible_structural_only", "cap_dropped", "invalid_or_unresolved", "no_eligible_related_context"]}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["record_type", "region_id", "case_id", "source_hash", "arm", "batch_id", "target_ids", "target_block_ids", "target_slice_refs", "primary_spans", "context_refs", "included_hint_ids", "render_items", "render_order", "metrics", "caps", "token_estimator", "context_events", "stop_reasons", "policy_version", "dependencies", "fingerprint"], "properties": {
      "record_type": {"const": "AnalysisRegionManifest"}, "region_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/case"}, "source_hash": {"$ref": "#/$defs/hash"}, "arm": {"enum": ["P2a", "P2b"]}, "batch_id": {"$ref": "#/$defs/id"}, "target_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "target_block_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "target_slice_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "primary_spans": {"type": "array", "items": {"$ref": "#/$defs/span"}}, "context_refs": {"type": "array", "items": {"$ref": "#/$defs/context"}}, "included_hint_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "render_items": {"type": "array", "items": {"$ref": "#/$defs/render"}}, "render_order": {"type": "array", "items": {"type": "string"}}, "metrics": {"$ref": "#/$defs/metrics"}, "caps": {"type": "object"}, "token_estimator": {"type": "object"}, "context_events": {"type": "array", "items": {"$ref": "#/$defs/event"}}, "stop_reasons": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "policy_version": {"type": "string"}, "dependencies": {"$ref": "#/$defs/deps"}, "fingerprint": {"$ref": "#/$defs/hash"}
    }}
  }
}
