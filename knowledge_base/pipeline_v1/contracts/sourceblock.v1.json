{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coliee:knowledge-base:pipeline-v1:source-block-v1",
  "title": "Pipeline V1 SourceBlock map",
  "$comment": "cache_key and block_id use the documented canonical named-field payloads. Parser events use sourceblock-event-v2 identity including case/source/parser/policy, related block ID/order, type, severity, message code, exact canonical message, and span.",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "case_id", "source_hash", "parser_version", "policy_sha256", "cache_key", "source_char_length", "blocks", "parser_events", "relations"],
  "properties": {
    "artifact_type": {"const": "SourceBlockMap"},
    "schema_version": {"const": "source-block-v1"},
    "case_id": {"$ref": "#/$defs/caseId"},
    "source_hash": {"$ref": "#/$defs/sha256"},
    "parser_version": {"type": "string", "minLength": 1},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "cache_key": {"$ref": "#/$defs/sha256"},
    "source_char_length": {"type": "integer", "minimum": 0},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/sourceBlock"}},
    "parser_events": {"type": "array", "items": {"$ref": "#/$defs/parserEvent"}},
    "relations": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "caseId": {"type": "string", "pattern": "^[0-9]{6}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_hash", "start_char", "end_char"],
      "properties": {
        "case_id": {"$ref": "#/$defs/caseId"},
        "source_hash": {"$ref": "#/$defs/sha256"},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 0}
      }
    },
    "nestedSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_type", "span", "status", "producer_version"],
      "properties": {
        "span_type": {"enum": ["citation_year", "citation_candidate", "list_marker", "quotation_candidate"]},
        "span": {"$ref": "#/$defs/spanRef"},
        "status": {"const": "observed_candidate"},
        "producer_version": {"type": "string", "minLength": 1}
      }
    },
    "sourceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "block_id", "case_id", "source_hash", "parser_version", "policy_sha256", "order", "block_type", "span", "content_span", "marker_span", "heading_candidate", "parser_confidence", "nested_spans"],
      "properties": {
        "record_type": {"const": "SourceBlock"},
        "block_id": {"type": "string", "pattern": "^sb-[0-9a-f]{24}$"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "source_hash": {"$ref": "#/$defs/sha256"},
        "parser_version": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "order": {"type": "integer", "minimum": 0},
        "block_type": {"enum": ["numbered_paragraph", "unnumbered_paragraph", "independent_line", "list_item", "quotation_block", "footnote", "table_or_form", "editorial", "heading_candidate", "whitespace", "unknown"]},
        "span": {"$ref": "#/$defs/spanRef"},
        "content_span": {"$ref": "#/$defs/spanRef"},
        "marker_span": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/spanRef"}]},
        "heading_candidate": {"type": "boolean"},
        "parser_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "nested_spans": {"type": "array", "items": {"$ref": "#/$defs/nestedSpan"}}
      }
    },
    "parserEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_contract_version", "event_id", "case_id", "source_hash", "parser_version", "policy_sha256", "block_id", "block_order", "event_type", "severity", "message_code", "span", "message"],
      "properties": {
        "event_contract_version": {"const": "sourceblock-event-v2"},
        "event_id": {"type": "string", "pattern": "^evt-[0-9a-f]{20}$"},
        "case_id": {"$ref": "#/$defs/caseId"},
        "source_hash": {"$ref": "#/$defs/sha256"},
        "parser_version": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "block_id": {"type": "string", "pattern": "^sb-[0-9a-f]{24}$"},
        "block_order": {"type": "integer", "minimum": 0},
        "event_type": {"enum": ["heading_candidate_review", "bracket_year_protected", "unclosed_quotation", "very_long_block", "unknown_block"]},
        "severity": {"enum": ["info", "review", "error"]},
        "message_code": {"type": "string", "minLength": 1},
        "span": {"$ref": "#/$defs/spanRef"},
        "message": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"event_type": {"const": "heading_candidate_review"}}},
          "then": {"properties": {"severity": {"const": "review"}, "message_code": {"const": "heading_candidate_requires_semantic_review"}, "message": {"const": "Formal heading candidate; semantic role is not asserted."}}}
        },
        {
          "if": {"properties": {"event_type": {"const": "bracket_year_protected"}}},
          "then": {"properties": {"severity": {"const": "info"}, "message_code": {"const": "bracket_year_excluded_from_paragraph_marker"}, "message": {"const": "Bracketed year protected from paragraph-marker classification."}}}
        },
        {
          "if": {"properties": {"event_type": {"const": "unclosed_quotation"}}},
          "then": {"properties": {"severity": {"const": "review"}, "message_code": {"const": "odd_straight_quote_count_requires_review"}, "message": {"const": "Odd straight-quote count; inspect quotation continuation."}}}
        },
        {
          "if": {"properties": {"event_type": {"const": "very_long_block"}}},
          "then": {"properties": {"severity": {"const": "review"}, "message_code": {"const": "block_exceeds_structural_review_threshold"}, "message": {"const": "Block exceeds the configured structural review threshold."}}}
        },
        {
          "if": {"properties": {"event_type": {"const": "unknown_block"}}},
          "then": {"properties": {"severity": {"const": "error"}, "message_code": {"const": "block_classification_failed"}, "message": {"const": "Parser could not classify this exact source range."}}}
        }
      ]
    }
  }
}

