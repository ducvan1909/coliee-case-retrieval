{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coliee:knowledge-base:pipeline-v1:annotation-schema-v1",
  "title": "Pipeline V1 minimum annotation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "source_sha256", "source_blocks", "authority_units", "context_obligations"],
  "properties": {
    "schema_version": {"const": "p2-annotation-v1"},
    "case_id": {"$ref": "#/$defs/caseId"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "source_blocks": {"type": "array", "items": {"$ref": "#/$defs/sourceBlock"}},
    "authority_units": {"type": "array", "items": {"$ref": "#/$defs/authorityUnit"}},
    "context_obligations": {"type": "array", "items": {"$ref": "#/$defs/contextObligation"}},
    "annotator_notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "caseId": {"type": "string", "pattern": "^[0-9]{6}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "minLength": 1},
    "spanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_sha256", "start_char", "end_char"],
      "properties": {
        "case_id": {"$ref": "#/$defs/caseId"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "start_char": {"type": "integer", "minimum": 0},
        "end_char": {"type": "integer", "minimum": 1},
        "text_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "annotationStatus": {
      "enum": ["candidate", "needs_adjudication", "adjudicated", "rejected", "unknown"]
    },
    "sourceBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "span", "ordinal", "block_type", "annotation_status", "errors"],
      "properties": {
        "block_id": {"$ref": "#/$defs/identifier"},
        "span": {"$ref": "#/$defs/spanRef"},
        "ordinal": {"type": "integer", "minimum": 0},
        "block_type": {"enum": ["heading", "paragraph", "list_item", "quotation", "footnote", "editorial", "unknown"]},
        "annotation_status": {"$ref": "#/$defs/annotationStatus"},
        "marker_text": {"type": ["string", "null"]},
        "errors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["false_heading_candidate", "marker_confusion", "quote_or_list_continuation", "protected_span_split"],
          "properties": {
            "false_heading_candidate": {"type": "boolean"},
            "marker_confusion": {"type": "boolean"},
            "quote_or_list_continuation": {"type": "boolean"},
            "protected_span_split": {"type": "boolean"},
            "notes": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_span", "role", "speaker", "status"],
      "properties": {
        "evidence_span": {"$ref": "#/$defs/spanRef"},
        "role": {"enum": ["proposition", "authority", "current_court_response", "condition", "exception", "limit", "other"]},
        "speaker": {"enum": ["current_court", "cited_authority", "party", "statute", "editor", "mixed", "unknown"]},
        "status": {"$ref": "#/$defs/annotationStatus"},
        "notes": {"type": "string"}
      }
    },
    "authorityUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["au_id", "proposition_span", "evidence_spans", "kind", "attributions", "condition_spans", "exception_spans", "limit_spans", "annotation_status", "context_obligation_ids"],
      "properties": {
        "au_id": {"$ref": "#/$defs/identifier"},
        "proposition_span": {"$ref": "#/$defs/spanRef"},
        "evidence_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spanRef"}},
        "kind": {"enum": ["rule", "test", "interpretation", "application", "standard_of_review", "procedural", "other", "unknown"]},
        "attributions": {"type": "array", "items": {"$ref": "#/$defs/attribution"}},
        "condition_spans": {"type": "array", "items": {"$ref": "#/$defs/spanRef"}},
        "exception_spans": {"type": "array", "items": {"$ref": "#/$defs/spanRef"}},
        "limit_spans": {"type": "array", "items": {"$ref": "#/$defs/spanRef"}},
        "annotation_status": {"$ref": "#/$defs/annotationStatus"},
        "duplicate_of": {"type": ["string", "null"]},
        "context_obligation_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contextObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "target_kind", "target_id", "obligation_type", "requested_context", "reason", "producer", "run_id", "status"],
      "properties": {
        "obligation_id": {"$ref": "#/$defs/identifier"},
        "target_kind": {"enum": ["source_block", "authority_unit", "analysis_target"]},
        "target_id": {"$ref": "#/$defs/identifier"},
        "obligation_type": {"enum": ["attribution", "condition", "exception", "limit", "current_court_response", "cross_block_context", "other"]},
        "requested_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction"],
          "properties": {
            "direction": {"enum": ["before", "after", "both", "exact_span", "unknown"]},
            "span": {"$ref": "#/$defs/spanRef"},
            "max_blocks": {"type": "integer", "minimum": 1}
          }
        },
        "reason": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending", "satisfied", "unresolved", "budget_exhausted", "rejected"]},
        "resolution_spans": {"type": "array", "items": {"$ref": "#/$defs/spanRef"}}
      }
    }
  }
}

