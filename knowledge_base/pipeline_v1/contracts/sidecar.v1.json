{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coliee:knowledge-base:pipeline-v1:sidecar-map-v1",
  "title": "Pipeline V1 Sidecar annotation and structural relation map",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "case_id", "source_hash", "sourceblock_cache_key", "sentence_atom_cache_key", "worker_bundle_version", "policy_sha256", "cache_key", "run_status", "failed_workers", "worker_runs", "annotations", "relations", "worker_events", "adjacency_policy"],
  "properties": {
    "artifact_type": {"const": "SidecarMap"}, "schema_version": {"const": "sidecar-map-v1"},
    "case_id": {"$ref": "#/$defs/caseId"}, "source_hash": {"$ref": "#/$defs/sha256"},
    "sourceblock_cache_key": {"$ref": "#/$defs/sha256"}, "sentence_atom_cache_key": {"$ref": "#/$defs/sha256"},
    "worker_bundle_version": {"type": "string", "minLength": 1}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "cache_key": {"$ref": "#/$defs/sha256"},
    "run_status": {"enum": ["complete", "partial"]}, "failed_workers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "worker_runs": {"type": "array", "items": {"$ref": "#/$defs/workerRun"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "worker_events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "adjacency_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["materialized", "derived_from", "directions"],
      "properties": {"materialized": {"const": false}, "derived_from": {"const": "SourceBlock.order"}, "directions": {"const": ["next", "previous"]}}
    }
  },
  "$defs": {
    "caseId": {"type": "string", "pattern": "^[0-9]{6}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "spanRef": {"type": "object", "additionalProperties": false, "required": ["case_id", "source_hash", "start_char", "end_char"], "properties": {"case_id": {"$ref": "#/$defs/caseId"}, "source_hash": {"$ref": "#/$defs/sha256"}, "start_char": {"type": "integer", "minimum": 0}, "end_char": {"type": "integer", "minimum": 0}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["sourceblock_cache_key", "sentence_atom_cache_key", "sourceblock_policy_sha256", "sentence_policy_sha256", "sidecar_policy_sha256"], "properties": {"sourceblock_cache_key": {"$ref": "#/$defs/sha256"}, "sentence_atom_cache_key": {"$ref": "#/$defs/sha256"}, "sourceblock_policy_sha256": {"$ref": "#/$defs/sha256"}, "sentence_policy_sha256": {"$ref": "#/$defs/sha256"}, "sidecar_policy_sha256": {"$ref": "#/$defs/sha256"}}},
    "workerRun": {"type": "object", "additionalProperties": false, "required": ["worker_type", "producer_version", "status", "output_count"], "properties": {"worker_type": {"enum": ["marker_rule", "citation_reference_rule", "nested_structure_inheritance", "quote_balance_rule", "speaker_cue_rule", "structural_relation_rule"]}, "producer_version": {"type": "string", "minLength": 1}, "status": {"enum": ["complete", "failed"]}, "output_count": {"type": "integer", "minimum": 0}}},
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "annotation_id", "case_id", "source_hash", "span", "block_id", "atom_refs", "worker_type", "annotation_type", "value_code", "status", "producer_version", "evidence_refs", "dependencies"],
      "properties": {
        "record_type": {"const": "Annotation"}, "annotation_id": {"type": "string", "pattern": "^an-[0-9a-f]{24}$"},
        "case_id": {"$ref": "#/$defs/caseId"}, "source_hash": {"$ref": "#/$defs/sha256"}, "span": {"$ref": "#/$defs/spanRef"},
        "block_id": {"type": "string", "pattern": "^sb-[0-9a-f]{24}$"}, "atom_refs": {"type": "array", "items": {"type": "string", "pattern": "^sa-[0-9a-f]{24}$"}, "uniqueItems": true},
        "worker_type": {"enum": ["marker_rule", "citation_reference_rule", "nested_structure_inheritance", "quote_balance_rule", "speaker_cue_rule"]},
        "annotation_type": {"enum": ["suppression_marker", "paragraph_marker", "citation_year", "neutral_citation", "reporter_citation", "section_reference", "case_reference", "nested_quote", "nested_list", "quote_balance", "speaker_cue"]},
        "value_code": {"type": "string", "minLength": 1}, "status": {"enum": ["observed", "candidate", "review", "error"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "confidence_definition": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "dependencies": {"$ref": "#/$defs/dependency"}
      },
      "dependentRequired": {"confidence": ["confidence_definition"], "confidence_definition": ["confidence"]}
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "relation_id", "case_id", "source_hash", "relation_type", "relation_subtype", "source_ref", "target_ref", "direction", "status", "evidence_spans", "evidence_refs", "producer_version", "dependencies", "reconstructable"],
      "properties": {
        "record_type": {"const": "StructuralRelation"}, "relation_id": {"type": "string", "pattern": "^sr-[0-9a-f]{24}$"},
        "case_id": {"$ref": "#/$defs/caseId"}, "source_hash": {"$ref": "#/$defs/sha256"},
        "relation_type": {"enum": ["containment", "continuation", "governed_by_heading"]}, "relation_subtype": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}, "target_ref": {"type": "string", "minLength": 1},
        "direction": {"enum": ["outgoing", "incoming"]}, "status": {"enum": ["observed", "candidate", "review", "error"]},
        "evidence_spans": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spanRef"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "producer_version": {"type": "string", "minLength": 1}, "dependencies": {"$ref": "#/$defs/dependency"}, "reconstructable": {"type": "boolean"}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "worker_type", "severity", "status", "case_id", "source_hash", "message_code", "message"],
      "properties": {"event_id": {"type": "string", "pattern": "^we-[0-9a-f]{20}$"}, "worker_type": {"type": "string", "minLength": 1}, "severity": {"enum": ["review", "error"]}, "status": {"enum": ["review", "error"]}, "case_id": {"$ref": "#/$defs/caseId"}, "source_hash": {"$ref": "#/$defs/sha256"}, "message_code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
    }
  }
}
