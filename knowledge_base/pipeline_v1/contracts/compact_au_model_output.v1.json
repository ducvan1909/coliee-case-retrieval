{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coliee:pipeline-v1:compact-au-model-output-v1",
  "title": "Compact AU model output",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "target_id", "decision", "coverage_status", "aus", "hard_negative_reason", "unresolved_reason"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "decision": {"enum": ["positive", "hard_negative", "unresolved"]},
    "coverage_status": {"enum": ["complete", "needs_split"]},
    "aus": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/au"}},
    "hard_negative_reason": {"enum": [null, "party_argument_only", "fact_only", "procedural_history_only", "citation_without_proposition", "editorial", "insufficient_context", "other"]},
    "unresolved_reason": {"enum": [null, "needs_split", "insufficient_context", "ambiguous_speaker", "ambiguous_kind", "ambiguous_boundary", "conflicting_evidence", "other"]}
  },
  "$defs": {
    "au": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "other_kind", "claim", "evidence_ref_ids", "speaker", "attribution_role", "needs_context"],
      "properties": {
        "kind": {"enum": ["holding", "standard_of_review", "statutory_hook", "procedural_rule", "fact_pattern_rule", "foreign_law", "other", "unresolved_kind"]},
        "other_kind": {"type": ["string", "null"], "maxLength": 160},
        "claim": {"type": "string", "minLength": 1, "maxLength": 300},
        "evidence_ref_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "speaker": {"enum": ["current_court", "cited_authority", "party", "statute", "editor", "mixed", "unknown"]},
        "attribution_role": {"enum": ["proposition", "authority", "current_court_response", "condition", "exception", "limit", "other"]},
        "needs_context": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"enum": ["attribution", "condition", "exception", "limit", "current_court_response", "cross_block_context"]}}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "other"}}}, "then": {"properties": {"other_kind": {"type": "string", "minLength": 1}}}, "else": {"properties": {"other_kind": {"const": null}}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "positive"}}}, "then": {"properties": {"aus": {"minItems": 1}, "hard_negative_reason": {"const": null}, "unresolved_reason": {"const": null}}}},
    {"if": {"properties": {"decision": {"const": "hard_negative"}}}, "then": {"properties": {"aus": {"maxItems": 0}, "coverage_status": {"const": "complete"}, "hard_negative_reason": {"type": "string"}, "unresolved_reason": {"const": null}}}},
    {"if": {"properties": {"decision": {"const": "unresolved"}}}, "then": {"properties": {"aus": {"maxItems": 0}, "hard_negative_reason": {"const": null}, "unresolved_reason": {"type": "string"}}}}
  ]
}
